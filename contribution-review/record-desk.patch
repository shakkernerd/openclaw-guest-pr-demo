+++ b/review-browser.test.js
@@ -0,0 +1,273 @@
+"use strict";
+
+// Optional real-browser checks using an already-installed Chromium. No packages,
+// server, or browser download. Default node --test clearly skips these if absent.
+const test = require("node:test");
+const assert = require("node:assert/strict");
+const fs = require("node:fs");
+const os = require("node:os");
+const path = require("node:path");
+const { pathToFileURL } = require("node:url");
+const { spawn } = require("node:child_process");
+const browser = process.env.RECORD_REVIEW_BROWSER;
+
+// Drive the existing browser over a local pipe, waiting for the actual result.
+// No HTTP server, debug port, dependencies, or virtual-time iframe races.
+async function runBrowser(args, directory, url) {
+  const child = spawn(browser, [...args, "--remote-debugging-pipe", "about:blank"], {
+    stdio: ["ignore", "ignore", "pipe", "pipe", "pipe"],
+    env: { ...process.env, HOME: directory, XDG_CONFIG_HOME: directory, XDG_CACHE_HOME: directory },
+  });
+  let buffer = "";
+  let diagnostic = "";
+  let nextId = 0;
+  const pending = new Map();
+  let report;
+  let fail;
+  const completed = new Promise((resolve, reject) => { report = resolve; fail = reject; });
+  // Attach immediately so early browser errors cannot become unhandled rejections.
+  completed.catch(() => {});
+  const timer = setTimeout(() => fail(new Error("Browser timed out: " + diagnostic.slice(-3000))), 20000);
+  child.stderr.on("data", chunk => { diagnostic += chunk; });
+  child.on("error", fail);
+  child.on("exit", code => {
+    const error = new Error("Browser exited " + code + ": " + diagnostic.slice(-3000));
+    for (const entry of pending.values()) entry.reject(error);
+    pending.clear();
+    fail(error);
+  });
+  child.stdio[4].setEncoding("utf8");
+  child.stdio[4].on("data", chunk => {
+    buffer += chunk;
+    let end;
+    while ((end = buffer.indexOf("\0")) !== -1) {
+      const message = JSON.parse(buffer.slice(0, end));
+      buffer = buffer.slice(end + 1);
+      if (message.id) {
+        const entry = pending.get(message.id);
+        if (entry) {
+          pending.delete(message.id);
+          if (message.error) entry.reject(new Error(JSON.stringify(message.error)));
+          else entry.resolve(message.result);
+        }
+      } else if (message.method === "Runtime.bindingCalled" && message.params.name === "reportReviewTest") {
+        report(message.params.payload);
+      } else if (message.method === "Runtime.exceptionThrown") {
+        diagnostic += JSON.stringify(message.params);
+      }
+    }
+  });
+  const send = (method, params = {}, sessionId) => new Promise((resolve, reject) => {
+    const id = ++nextId;
+    pending.set(id, { resolve, reject });
+    child.stdio[3].write(JSON.stringify({ id, method, params, sessionId }) + "\0");
+  });
+  try {
+    const { targetId } = await send("Target.createTarget", { url: "about:blank" });
+    const { sessionId } = await send("Target.attachToTarget", { targetId, flatten: true });
+    await send("Runtime.enable", {}, sessionId);
+    await send("Runtime.addBinding", { name: "reportReviewTest" }, sessionId);
+    await send("Page.enable", {}, sessionId);
+    await send("Page.navigate", { url }, sessionId);
+    return await completed;
+  } finally {
+    clearTimeout(timer);
+    const exited = new Promise(resolve => child.once("exit", resolve));
+    child.kill();
+    if (child.exitCode === null && child.signalCode === null) await exited;
+  }
+}
+
+// This function runs inside the shipped page, not a mock DOM.
+async function exercise(mode) {
+  const $ = id => document.getElementById(id);
+  const check = (condition, message) => { if (!condition) throw new Error(message); };
+  const fire = (id, value, event = "input") => {
+    $(id).value = value;
+    $(id).dispatchEvent(new Event(event, { bubbles: true }));
+  };
+  const click = id => $(id).click();
+  const decision = value => document.querySelector('[data-decision="' + value + '"]').click();
+  const paste = value => { $("paste-json").value = value; click("import-paste"); };
+  const snapshot = () => { click("export-open"); return $("export-json").value; };
+  const tick = () => new Promise(resolve => setTimeout(resolve, 20));
+  const finish = result => {
+    if (mode === "sandbox") parent.postMessage({ recordReviewTest: result }, "*");
+    else {
+      const output = document.createElement("pre");
+      output.id = "result";
+      output.textContent = result;
+      document.body.append(output);
+      window.reportReviewTest(result);
+    }
+  };
+  try {
+    if (mode === "reload" && sessionStorage.getItem("review-test-phase") === "reload") {
+      check($("storage-status").textContent.startsWith("Restored"), "reload did not announce restoration");
+      const restored = JSON.parse(snapshot());
+      check(restored.reviews["R-101"].decision === "approved", "decision lost across reload");
+      check(restored.reviews["R-101"].notes === "Survives a real reload ✓", "notes lost across reload");
+      check(restored.records.length === 4, "records lost across reload");
+      finish("PASS reload");
+      return;
+    }
+    if (mode === "corrupt") {
+      check($("storage-status").textContent.includes("has not been overwritten"), "corrupt storage warning missing");
+      check(localStorage.getItem("record-review:v1") === "{corrupt", "startup overwrote corrupt storage");
+      paste("not JSON");
+      check(localStorage.getItem("record-review:v1") === "{corrupt", "invalid import overwrote corrupt storage");
+      click("sample");
+      check(JSON.parse(localStorage.getItem("record-review:v1")).records.length === 4, "valid import did not replace corrupt save");
+      finish("PASS corrupt");
+      return;
+    }
+    if (mode === "quota") {
+      check($("storage-status").textContent.startsWith("Restored"), "readable storage not restored");
+      decision("approved");
+      fire("notes", "Still in memory");
+      check($("storage-status").textContent.startsWith("Memory only"), "quota failure incorrectly announced saved");
+      const exported = JSON.parse(snapshot());
+      check(exported.reviews.a.notes === "Still in memory", "quota failure lost notes");
+      check(exported.reviews.a.decision === "approved", "quota failure lost decision");
+      check(JSON.parse(localStorage.getItem("record-review:v1")).reviews.a.decision === "unreviewed", "quota test unexpectedly saved");
+      finish("PASS quota");
+      return;
+    }
+    if (mode === "sandbox") {
+      let denied = false;
+      try { window.localStorage.getItem("test"); } catch { denied = true; }
+      check(denied, "fixture must deny storage with an opaque origin");
+      check($("storage-status").textContent.startsWith("Memory only"), "missing sandbox storage warning");
+    }
+    click("sample");
+    check(document.querySelectorAll(".record").length === 4, "sample list missing");
+    check($("record-id").textContent === "R-101", "first record not selected");
+    decision("approved");
+    fire("notes", "Survives a real reload ✓");
+    if (mode === "reload") {
+      check($("storage-status").textContent.startsWith("Saved"), "browser did not save");
+      const saved = localStorage.getItem("record-review:v1");
+      paste("[{bad JSON]");
+      check(localStorage.getItem("record-review:v1") === saved, "invalid import modified saved storage");
+      check(snapshot() === saved, "invalid import modified live review");
+      sessionStorage.setItem("review-test-phase", "reload");
+      location.reload();
+      return;
+    }
+    check($("count-progress").textContent === "1 / 4", "decision totals wrong");
+    const before = snapshot();
+    paste('[{"id":"ok","title":"First valid"},{"id":"bad"}]');
+    check($("import-error").textContent.includes("unchanged"), "validation message missing");
+    check(snapshot() === before, "late invalid record replaced accepted data");
+    paste('{"format":"record-review","version":2}');
+    check(snapshot() === before, "invalid snapshot replaced accepted data");
+    paste('[{"id":"x","title":"One"},{"id":"x","title":"Duplicate"}]');
+    check(snapshot() === before, "duplicate ID replaced accepted data");
+    fire("search", "PARCEL");
+    check(document.querySelectorAll(".record").length === 1, "search not case insensitive");
+    check($("record-id").textContent === "R-102", "search selected wrong record");
+    fire("filter", "approved", "change");
+    check(!$("empty").hidden && $("record-editor").hidden, "empty filter has stale editor");
+    check(snapshot() === before, "filter changed exported data");
+    fire("search", "");
+    check($("record-id").textContent === "R-101", "filter selection not recovered");
+    decision("rejected");
+    check($("record-editor").hidden, "decision moving out of filter left stale editor");
+    fire("filter", "all", "change");
+    check($("notes").value === "Survives a real reload ✓", "notes lost across filtering");
+    paste(before); // exact snapshot restore
+    check(snapshot() === before, "snapshot import did not round-trip");
+    click("select-export");
+    check($("export-json").selectionStart === 0 && $("export-json").selectionEnd === before.length, "manual copy fallback did not select export");
+    click("download"); // blocked silently by the unchanged restrictive iframe
+    check($("download-status").textContent.includes("not confirmed"), "download falsely claimed completion");
+    const originalCreateURL = URL.createObjectURL;
+    URL.createObjectURL = () => { throw new Error("Unavailable"); };
+    click("download");
+    check($("download-status").textContent.includes("unavailable"), "throwing download fallback failed");
+    check(snapshot() === before, "download failure changed review");
+    URL.createObjectURL = originalCreateURL;
+
+    // Actual File input, including the async read and same-file retry reset.
+    const fileInput = $("file-input");
+    const transfer = new DataTransfer();
+    transfer.items.add(new File(['[{"id":"file","title":"From file"}]'], "records.json", { type: "application/json" }));
+    fileInput.files = transfer.files;
+    fileInput.dispatchEvent(new Event("change"));
+    for (let i = 0; i < 100 && $("record-id").textContent !== "file"; i++) await tick();
+    check($("record-id").textContent === "file", "file import did not complete");
+    check(fileInput.value === "", "file input did not reset for retry");
+
+    // Controllable reads expose the race: latest *started* import must win.
+    function deferredFile(name) {
+      let resolve;
+      let reject;
+      const pending = new Promise((yes, no) => { resolve = yes; reject = no; });
+      Object.defineProperty(fileInput, "files", { configurable: true, value: [{ name, text: () => pending }] });
+      fileInput.dispatchEvent(new Event("change"));
+      return { resolve, reject };
+    }
+    const slow = deferredFile("slow.json");
+    paste(before);
+    slow.resolve('[{"id":"stale","title":"Must not win"}]');
+    await tick();
+    check(snapshot() === before, "slow file replaced newer paste");
+    const old = deferredFile("old.json");
+    const latest = deferredFile("new.json");
+    latest.resolve('[{"id":"new","title":"Newest"}]');
+    await tick();
+    const newest = snapshot();
+    old.resolve('[{"id":"old","title":"Older"}]');
+    await tick();
+    check(snapshot() === newest, "out-of-order files reverted newer import");
+    const pending = deferredFile("pending.json");
+    paste("invalid JSON");
+    pending.resolve(before);
+    await tick();
+    check(snapshot() === newest, "rejected newer import allowed stale completion");
+    const failed = deferredFile("failed.json");
+    failed.reject(new Error("Unreadable"));
+    await tick();
+    check(snapshot() === newest && $("import-error").textContent.includes("Could not read"), "file read failure was not atomic");
+
+    // Imported markup is text, not active HTML; prototype-like IDs are safe.
+    const hostile = '<img src=x onerror="window.injected=true">';
+    paste(JSON.stringify([{ id: "__proto__", title: hostile, extra: "</textarea>" }]));
+    check($("record-title").textContent === hostile && !$("record-title").querySelector("img"), "title rendered as HTML");
+    check(!window.injected, "imported markup executed");
+    decision("follow-up");
+    fire("notes", "Safe notes ✓");
+    check(JSON.parse(snapshot()).reviews.__proto__.notes === "Safe notes ✓", "special ID failed in browser");
+    paste("[]");
+    check($("record-editor").hidden && $("count-progress").textContent === "0 / 0", "valid empty import left stale data");
+    check(JSON.parse(snapshot()).records.length === 0, "empty export invalid");
+    check(performance.getEntriesByType("resource").length === 0, "app made resource requests");
+    finish("PASS sandbox");
+  } catch (error) { finish("FAIL " + error.message + "\n" + error.stack); }
+}
+
+for (const mode of ["sandbox", "reload", "corrupt", "quota"]) {
+  test("browser: " + mode, { skip: !browser && "Set RECORD_REVIEW_BROWSER to an existing Chromium executable", timeout: 30000 }, async () => {
+    const directory = fs.mkdtempSync(path.join(os.tmpdir(), "record-review-browser-"));
+    try {
+      let html = fs.readFileSync(path.join(__dirname, "index.html"), "utf8");
+      let setup = "";
+      if (mode === "corrupt") setup = 'localStorage.setItem("record-review:v1", "{corrupt");';
+      if (mode === "quota") setup = 'localStorage.setItem("record-review:v1", JSON.stringify({format:"record-review",version:1,records:[{id:"a",title:"Stored"}],reviews:{a:{decision:"unreviewed",notes:""}}})); Storage.prototype.setItem = function () { throw new DOMException("Full", "QuotaExceededError"); };';
+      html = html.replace("<script>", "<script>" + setup + "</script><script>");
+      html = html.replace("</body>", "<script>(" + exercise.toString() + ")(" + JSON.stringify(mode) + ");</script></body>");
+      if (mode === "sandbox") {
+        const escaped = html.replaceAll("&", "&amp;").replaceAll('"', "&quot;").replaceAll("<", "&lt;").replaceAll(">", "&gt;");
+        html = '<!doctype html><html><body><pre id="result">WAITING</pre><script>addEventListener("message", event => { if (event.source === document.querySelector("iframe").contentWindow && event.data.recordReviewTest) window.reportReviewTest(event.data.recordReviewTest); });</script><iframe sandbox="allow-scripts" srcdoc="' + escaped + '"></iframe></body></html>';
+      }
+      const file = path.join(directory, "test.html");
+      fs.writeFileSync(file, html);
+      const args = ["--headless", "--disable-gpu", "--disable-dev-shm-usage", "--no-first-run", "--no-default-browser-check", "--disable-background-networking", "--user-data-dir=" + path.join(directory, "profile"), "--disable-component-update"];
+      // Opt in only for an already-isolated container without Chromium OS sandbox
+      // support. This never changes the Files preview or iframe permissions.
+      if (process.env.RECORD_REVIEW_BROWSER_NO_SANDBOX === "1") args.unshift("--no-sandbox");
+      const result = await runBrowser(args, directory, pathToFileURL(file).href);
+      assert.equal(result, "PASS " + mode, "Browser result: " + result);
+    } finally { fs.rmSync(directory, { recursive: true, force: true }); }
+  });
+}
diff --git a/review-state.js b/review-state.js
new file mode 100644
index 0000000000000000000000000000000000000000..1889d8670b1452a2c125c845f1848102527018d4
--- /dev/null
+++ b/review-state.js
@@ -0,0 +1,123 @@
+/* Shared by the offline browser app and Node's built-in tests. */
+(function (root, factory) {
+  "use strict";
+  const api = factory();
+  if (typeof module === "object" && module.exports) module.exports = api;
+  else root.RecordReview = api;
+})(typeof globalThis === "object" ? globalThis : this, function () {
+  "use strict";
+  const FORMAT = "record-review";
+  const VERSION = 1;
+  const STORAGE_KEY = "record-review:v1";
+  const DECISIONS = Object.freeze(["unreviewed", "approved", "rejected", "follow-up"]);
+  const own = (object, key) => Object.prototype.hasOwnProperty.call(object, key);
+  const object = value => value !== null && typeof value === "object" && !Array.isArray(value);
+  const blankReview = () => ({ decision: "unreviewed", notes: "" });
+  const emptyState = () => ({ format: FORMAT, version: VERSION, records: [], reviews: {} });
+
+  function validateRecords(records) {
+    if (!Array.isArray(records)) throw new Error("Records must be a JSON array.");
+    const ids = new Set();
+    records.forEach((record, index) => {
+      const position = "Record " + (index + 1);
+      if (!object(record)) throw new Error(position + " must be an object.");
+      if (typeof record.id !== "string" || !record.id.trim()) {
+        throw new Error(position + " needs a non-empty string id (convert numeric IDs to strings).");
+      }
+      if (typeof record.title !== "string" || !record.title.trim()) {
+        throw new Error(position + " needs a non-empty string title.");
+      }
+      if (ids.has(record.id)) throw new Error(position + " repeats id " + JSON.stringify(record.id) + ".");
+      ids.add(record.id);
+    });
+    return ids;
+  }
+
+  function validateSnapshot(value) {
+    if (!object(value) || value.format !== FORMAT || value.version !== VERSION) {
+      throw new Error('Expected a records array or a version 1 "record-review" export.');
+    }
+    const ids = validateRecords(value.records);
+    if (!object(value.reviews)) throw new Error("Export reviews must be an object keyed by record ID.");
+    if (Object.keys(value.reviews).length !== ids.size) {
+      throw new Error("Export must contain exactly one review for every record.");
+    }
+    for (const [id, review] of Object.entries(value.reviews)) {
+      if (!ids.has(id)) throw new Error("Export contains a review for unknown id " + JSON.stringify(id) + ".");
+      if (!object(review) || !DECISIONS.includes(review.decision) || typeof review.notes !== "string") {
+        throw new Error("Invalid decision or notes for id " + JSON.stringify(id) + ".");
+      }
+    }
+    return {
+      format: FORMAT, version: VERSION, records: value.records,
+      reviews: Object.fromEntries(value.records.map(({ id }) => [id, {
+        decision: value.reviews[id].decision, notes: value.reviews[id].notes,
+      }])),
+    };
+  }
+
+  function parseJSON(text) {
+    if (typeof text !== "string" || !text.trim()) throw new Error("Choose a JSON file or paste JSON first.");
+    try { return JSON.parse(text.replace(/^\uFEFF/, "")); }
+    catch { throw new Error("Invalid JSON. Check commas, quotes, and brackets. Nothing was replaced."); }
+  }
+
+  // Pure transaction: finish all validation before returning a replacement.
+  // Raw datasets preserve reviews by exact ID; exports restore an exact snapshot.
+  function importJSON(text, previous = emptyState()) {
+    const value = parseJSON(text);
+    if (!Array.isArray(value)) return validateSnapshot(value);
+    validateRecords(value);
+    return {
+      format: FORMAT, version: VERSION, records: value,
+      reviews: Object.fromEntries(value.map(({ id }) => [id, own(previous.reviews, id)
+        ? { ...previous.reviews[id] } : blankReview()])),
+    };
+  }
+
+  function updateReview(state, id, patch) {
+    if (!own(state.reviews, id)) throw new Error("This record is not in the accepted dataset.");
+    const review = { ...state.reviews[id], ...patch };
+    if (!DECISIONS.includes(review.decision) || typeof review.notes !== "string") {
+      throw new Error("Choose a valid decision and use text for notes.");
+    }
+    return { ...state, reviews: { ...state.reviews, [id]: { decision: review.decision, notes: review.notes } } };
+  }
+
+  function visibleRecords(state, query = "", decision = "all") {
+    const needle = query.trim().toLowerCase();
+    return state.records.filter(record =>
+      (decision === "all" || state.reviews[record.id].decision === decision) &&
+      (!needle || (record.id + "\n" + record.title).toLowerCase().includes(needle)));
+  }
+
+  function counts(state) {
+    const result = Object.fromEntries(DECISIONS.map(decision => [decision, 0]));
+    for (const review of Object.values(state.reviews)) result[review.decision]++;
+    return { ...result, total: state.records.length, reviewed: state.records.length - result.unreviewed };
+  }
+
+  function exportJSON(state) { return JSON.stringify(validateSnapshot(state), null, 2); }
+
+  // The getter itself can throw in an opaque-origin iframe, before getItem runs.
+  function restore(getStorage) {
+    let text;
+    try { text = getStorage().getItem(STORAGE_KEY); }
+    catch { return { status: "unavailable", state: null }; }
+    if (text === null) return { status: "empty", state: null };
+    try { return { status: "restored", state: validateSnapshot(JSON.parse(text)) }; }
+    catch { return { status: "invalid", state: null }; }
+  }
+
+  function persist(getStorage, state) {
+    try {
+      getStorage().setItem(STORAGE_KEY, exportJSON(state));
+      return true;
+    } catch { return false; }
+  }
+
+  return Object.freeze({
+    FORMAT, VERSION, STORAGE_KEY, DECISIONS, emptyState, importJSON,
+    updateReview, visibleRecords, counts, exportJSON, restore, persist,
+  });
+});
diff --git a/review-state.test.js b/review-state.test.js
new file mode 100644
index 0000000000000000000000000000000000000000..b7fa943ada33029791ec98b4d7730b6de78f2afc
--- /dev/null
+++ b/review-state.test.js
@@ -0,0 +1,153 @@
+"use strict";
+
+const test = require("node:test");
+const assert = require("node:assert/strict");
+const fs = require("node:fs");
+const path = require("node:path");
+const vm = require("node:vm");
+const R = require("./review-state.js");
+const { build } = require("./build-review.js");
+
+const records = [{ id: "a", title: "Alpha", payload: { count: 3 } }, { id: "b", title: "Beta" }];
+const initial = () => R.importJSON(JSON.stringify(records));
+const reviewed = () => R.updateReview(initial(), "a", { decision: "approved", notes: "Checked ✓\nKeep this." });
+function freeze(value) {
+  Object.freeze(value);
+  for (const child of Object.values(value)) if (child && typeof child === "object") freeze(child);
+  return value;
+}
+
+test("raw import retains arbitrary JSON fields and creates independent blank reviews", () => {
+  const state = initial();
+  assert.deepEqual(state.records, records);
+  assert.deepEqual(state.reviews.a, { decision: "unreviewed", notes: "" });
+  assert.notEqual(state.reviews.a, state.reviews.b);
+  assert.deepEqual(R.importJSON("\uFEFF" + JSON.stringify(records)), state);
+});
+
+const invalidImports = [
+  "", " ", "{bad json", "null", "true", "42", '"text"', "{}", '{"records":[]}',
+  "[null]", "[[]]", '[{"id":1,"title":"Numeric ID"}]',
+  '[{"id":" ","title":"Empty ID"}]', '[{"title":"Missing ID"}]',
+  '[{"id":"a"}]', '[{"id":"a","title":" "}]', '[{"id":"a","title":3}]',
+  '[{"id":"a","title":"Valid first"},{"id":"a","title":"Late duplicate"}]',
+  '[{"id":"a","title":"Valid first"},{"id":"b","title":null}]',
+];
+for (const input of invalidImports) test("invalid import is atomic: " + input.slice(0, 70), () => {
+  const previous = freeze(reviewed());
+  const before = R.exportJSON(previous);
+  assert.throws(() => R.importJSON(input, previous));
+  assert.equal(R.exportJSON(previous), before);
+});
+
+test("reimport/reorder preserves exact matching IDs, not position or title", () => {
+  const previous = freeze(reviewed());
+  const next = R.importJSON(JSON.stringify([
+    { id: "b", title: "Now first" }, { id: "a", title: "Renamed" }, { id: "c", title: "New" },
+  ]), previous);
+  assert.deepEqual(next.reviews.a, previous.reviews.a);
+  assert.notEqual(next.reviews.a, previous.reviews.a);
+  assert.equal(next.reviews.b.decision, "unreviewed");
+  assert.equal(next.reviews.c.notes, "");
+  assert.equal(next.records[1].title, "Renamed");
+  const replaced = R.importJSON('[{"id":"A","title":"Case differs"}]', previous);
+  assert.deepEqual(Object.keys(replaced.reviews), ["A"]);
+  assert.equal(replaced.reviews.A.decision, "unreviewed");
+  assert.deepEqual(R.importJSON("[]", previous), R.emptyState());
+});
+
+test("prototype-like IDs are ordinary keys, never inherited reviews", () => {
+  const state = R.importJSON(JSON.stringify(["__proto__", "constructor", "toString", "hasOwnProperty"].map(id => ({ id, title: id }))));
+  assert.equal(Object.keys(state.reviews).length, 4);
+  assert.equal(Object.getPrototypeOf(state.reviews), Object.prototype);
+  const next = R.updateReview(state, "__proto__", { decision: "follow-up", notes: "Safe" });
+  assert.deepEqual(R.importJSON(R.exportJSON(next)), next);
+  assert.equal({}.decision, undefined);
+});
+
+test("all decisions and notes update immutably, including return to unreviewed", () => {
+  const previous = freeze(reviewed());
+  for (const decision of R.DECISIONS) {
+    const next = R.updateReview(previous, "a", { decision, notes: "" });
+    assert.equal(next.reviews.a.decision, decision);
+    assert.equal(next.reviews.a.notes, "");
+    assert.equal(previous.reviews.a.decision, "approved");
+  }
+  for (const patch of [{ decision: "unknown" }, { notes: null }]) assert.throws(() => R.updateReview(previous, "a", patch));
+  assert.throws(() => R.updateReview(previous, "missing", { notes: "lost" }));
+});
+
+test("search and decision filters compose without mutating reviews", () => {
+  const state = freeze(reviewed());
+  assert.deepEqual(R.visibleRecords(state, " ALPHA ", "approved").map(r => r.id), ["a"]);
+  assert.deepEqual(R.visibleRecords(state, "B", "unreviewed").map(r => r.id), ["b"]);
+  assert.equal(R.visibleRecords(state, "alpha", "rejected").length, 0);
+  assert.equal(R.visibleRecords(state, "no match").length, 0);
+  assert.deepEqual(R.counts(state), { unreviewed: 1, approved: 1, rejected: 0, "follow-up": 0, total: 2, reviewed: 1 });
+  assert.equal(R.counts(R.emptyState()).reviewed, 0);
+});
+
+test("exports round-trip full data and replace rather than merge review snapshots", () => {
+  const snapshot = reviewed();
+  const competing = R.updateReview(snapshot, "b", { decision: "rejected", notes: "Not in backup" });
+  assert.deepEqual(R.importJSON(R.exportJSON(snapshot), competing), snapshot);
+  const special = R.importJSON('[{"id":"x","title":"<img src=x onerror=alert(1)>","extra":[null,true,"雪"]}]');
+  const withNotes = R.updateReview(special, "x", { notes: "quotes: \" and newline\n</textarea>" });
+  assert.deepEqual(R.importJSON(R.exportJSON(withNotes)), withNotes);
+});
+
+test("invalid snapshots never partially replace accepted state", () => {
+  const previous = freeze(reviewed());
+  const before = R.exportJSON(previous);
+  const mutations = [
+    value => { value.version = 2; },
+    value => { value.format = "other"; },
+    value => { value.reviews.a.decision = "maybe"; },
+    value => { value.reviews.a.notes = 1; },
+    value => { value.reviews.a = null; },
+    value => { delete value.reviews.b; },
+    value => { value.reviews.unknown = value.reviews.b; delete value.reviews.b; },
+    value => { value.reviews = []; },
+    value => { value.records.push(value.records[0]); },
+  ];
+  for (const mutate of mutations) {
+    const invalid = JSON.parse(before);
+    mutate(invalid);
+    assert.throws(() => R.importJSON(JSON.stringify(invalid), previous));
+    assert.equal(R.exportJSON(previous), before);
+  }
+});
+
+test("storage restore and save use a versioned key and preserve the full snapshot", () => {
+  const map = new Map();
+  const storage = { getItem: key => map.get(key) ?? null, setItem: (key, value) => map.set(key, value) };
+  assert.deepEqual(R.restore(() => storage), { status: "empty", state: null });
+  assert.equal(R.persist(() => storage, reviewed()), true);
+  assert.deepEqual([...map.keys()], [R.STORAGE_KEY]);
+  assert.deepEqual(R.restore(() => storage), { status: "restored", state: reviewed() });
+});
+
+test("blocked getters, denied reads, quota failures, and corrupt saves are safe", () => {
+  const denied = () => { throw new Error("SecurityError"); };
+  assert.deepEqual(R.restore(denied), { status: "unavailable", state: null });
+  assert.equal(R.persist(denied, reviewed()), false);
+  assert.equal(R.restore(() => ({ getItem: denied })).status, "unavailable");
+  const previous = reviewed();
+  const before = R.exportJSON(previous);
+  assert.equal(R.persist(() => ({ setItem: denied }), previous), false);
+  assert.equal(R.exportJSON(previous), before);
+  let writes = 0;
+  for (const text of ["{broken", "null", "[]", '{"format":"record-review","version":99}', '{"format":"record-review","version":1,"records":[],"reviews":{"ghost":{}}}']) {
+    assert.deepEqual(R.restore(() => ({ getItem: () => text, setItem: () => writes++ })), { status: "invalid", state: null });
+  }
+  assert.equal(writes, 0);
+});
+
+test("shipped preview is fresh, self-contained, and its actual scripts parse", () => {
+  const html = fs.readFileSync(path.join(__dirname, "index.html"), "utf8");
+  assert.equal(html, build());
+  assert.doesNotMatch(html, /<script[^>]+src=|<link[^>]+href=|@import|\bfetch\s*\(|XMLHttpRequest/);
+  const scripts = [...html.matchAll(/<script>([\s\S]*?)<\/script>/g)];
+  assert.equal(scripts.length, 2);
+  for (const [, source] of scripts) new vm.Script(source);
+});
